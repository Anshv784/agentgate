# Tenant — from https://www.terminal3.io/claim-page (shown once, keep it safe)
T3N_API_KEY=0x...
T3N_TENANT_DID=did:t3n:...
T3N_ENV=testnet

# Agent — minted by probes/identity-model.ts (createOrganisation + createAgent).
# Opaque bearer token; the agent's signing key never leaves the TEE.
AGENT_KEY=t3n_key_...
AGENT_DID=did:t3n:...
ORG_DID=did:t3n:...
AGENT_KEY_ID=...          # recorded for reference; nothing reads it

# Data owner. In THIS deployment the tenant DID above stands in as data owner, so
# the two below are unused — nothing in the repo reads them. You do not need to go
# looking for a "user key": the claim page issues one identity, not three, and a
# separate data-owner DID is minted locally on first authenticate() if you want one.
# See docs/BUGS.md, "Identity model, as actually implemented".
# USER_KEY=0x...
# USER_DID=did:t3n:...

# Endpoint credentials, sealed into z:<tid>:secrets by `npm run deploy`
RESEND_API_KEY=re_...
